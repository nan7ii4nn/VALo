rules_version = '2';

// VALO 資產看板 // Firestore 安全規則
// 對應 index.html 的資料結構：users/{uid}/portfolio_data/{holdings|settings|memory|trade_history}
// 每位使用者只能讀寫「自己 uid 底下」的文件，任何其他人（包含未登入訪客）一律無法讀寫。
//
// 部署方式：
// 1. 開啟 https://console.firebase.google.com，選擇這個網頁使用的專案
// 2. 左側選單「建構」→「Firestore Database」→ 上方分頁「規則」
// 3. 把下面 service cloud.firestore { ... } 整段貼上去，取代原本的內容
// 4. 按右上角「發布」
//
// ⚠️ 常見誤區：Firestore Database 若是用「測試模式」建立的，會自動帶一份「30 天後到期、
// 到期後全部拒絕讀寫」的預設規則。到期後即使帳號正常登入、程式碼完全沒問題，
// 也會出現「登入讀不到舊資料」「新增/修改後雲端沒有更新」的現象，
// 必須手動貼上以下規則並發布，才會長期有效。

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/portfolio_data/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
