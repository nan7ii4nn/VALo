rules_version = '2';

// VALO Firestore 安全規則
// 用途：確保每位已登入使用者只能讀寫「屬於自己 uid」底下的資料，
// 其他人（包含未登入的訪客）完全無法讀取或竄改。
//
// 套用方式：
// 1. 打開 Firebase Console → 選擇你的專案 → 左側選單「Firestore Database」→「規則」分頁
// 2. 把下面的規則內容整段貼上，取代原本的內容
// 3. 按右上角「發布」
//
// ⚠️ 常見錯誤來源：Firebase 專案如果是用「測試模式」建立 Firestore，
// 系統會自動產生一條 30 天後過期、到期後全部拒絕讀寫的暫時規則。
// 一旦過期，即使帳號已登入，讀寫也會全部被拒絕（permission-denied），
// 且不會有明顯提示——這是本檔案 index.html 內建的雲端同步橫幅
// 主要想協助排查的情境之一。請務必手動貼上以下規則並發布，
// 不要依賴測試模式的預設規則。

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/portfolio_data/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
